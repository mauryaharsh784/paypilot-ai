NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/paypilot
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173
# lax works when the frontend proxies /api (Vite dev proxy, Vercel rewrite). Use none only for true cross-site setups.
COOKIE_SAMESITE=lax

# PayPal Sandbox (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# PayPal does not settle INR for most accounts, so the catalog (INR) is converted server-side at this fixed rate.
PAYPAL_CURRENCY=USD
INR_PER_UNIT=88

# AI: set one key. Without a key the agents run in deterministic rules mode (still tool-backed).
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Used by `npm run seed`
ADMIN_EMAIL=admin@paypilot.dev
ADMIN_PASSWORD=ChangeMe-Admin-123
